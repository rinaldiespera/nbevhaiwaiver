# Postgres connection string (any provider)
POSTGRES_URL="postgresql://user:pass@localhost:5432/waiver?sslmode=prefer"

# Shared bearer token used by Neighborly for /api/* endpoints
API_BEARER_TOKEN="change-me-please"

# Public base URL of the deployed app (used to build absolute signed QR URLs in
# GET /api/waiver-types[:id] responses, consumed by Neighborly and the admin
# QR-print page).  Leave the scheme/host correct for your deployment.
WAIVER_PUBLIC_BASE_URL="http://localhost:3000"

# Backwards-compat alias used by legacy code paths; WAIVER_PUBLIC_BASE_URL
# above takes precedence when both are set.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Waiver page access gating (new in this version)
# ---------------------------------------------------------------------------

# Long random HMAC secret used to mint & validate the `?h=` query param on
# printed waiver QR URLs.  Must match the secret on any system that generates
# QR URLs (Neighborly's backend uses GET /api/waiver-types to read pre-signed
# URLs, so it never needs to know this secret directly).
# Minimum 24 chars; server refuses to boot if missing/too short.
WAIVER_HASH_SECRET="change-me-to-a-long-random-string-of-at-least-24-chars"

# If true (default for production safety), visiting /waiver/<slug> without a
# valid ?h= signature shows a 403 "QR invalid/expired" page instead of the
# sign form.  Set to false TEMPORARILY while reprinting old unsigned QRs,
# then flip back to true.
WAIVER_HASH_REQUIRED="true"

# ---------------------------------------------------------------------------
# Admin/Neighborly REST API auth toggle
# ---------------------------------------------------------------------------

# If false (default for local docker dev): /api/* and /admin/qr-codes skip
# the Bearer-token check entirely for convenience.
# If true (production): all /api/* and /admin calls require the
# Authorization: Bearer <API_BEARER_TOKEN> header.  Server refuses to boot
# if this is true while API_BEARER_TOKEN is missing/too short.
ADMIN_API_AUTH_REQUIRED="false"

# ---- Blob storage configuration ----
# Choose driver: "local" (filesystem) or "s3" (any S3-compatible service)
BLOB_DRIVER="local"

# Local driver: directory where blobs are stored (relative to project root or absolute)
BLOB_LOCAL_DIR="./.blob-store"

# S3 driver: required when BLOB_DRIVER="s3"
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
# Optional: public URL prefix (if different from endpoint/bucket)
S3_PUBLIC_URL_BASE=""
